<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded glass window background for the dialog theme.

    Note: com.zhiyu.magisk.view.MagiskDialog replaces the window background with its own
    MaterialShapeDrawable (filled with ?colorSurfaceSurfaceVariant, which is translucent),
    so this drawable mainly serves dialogs and popups that rely on the theme background.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="@dimen/l1"
    android:insetTop="@dimen/l1"
    android:insetRight="@dimen/l1"
    android:insetBottom="@dimen/l1">

    <shape android:shape="rectangle">
        <corners android:radius="@dimen/glass_corner_dialog" />

        <gradient
            android:angle="270"
            android:endColor="?colorSurfaceSurfaceVariant"
            android:startColor="?colorSurface"
            android:type="linear" />

        <stroke
            android:width="@dimen/glass_border"
            android:color="?colorGlassBorder" />
    </shape>

</inset>
