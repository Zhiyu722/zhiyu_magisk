<?xml version="1.0" encoding="utf-8"?>
<!--
    Floating glass pill used as the background of the bottom navigation bar.

    It is deliberately a bit more opaque than @drawable/glass_surface: the navigation
    labels / icons must stay readable while page content scrolls underneath the pill.
    The rounded shape is what makes the bar look detached from the screen edges.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Frosted fill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_corner_pill" />
            <solid android:color="?colorSurface" />
        </shape>
    </item>

    <!-- Translucent white highlight (fades to fully transparent white) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_corner_pill" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="?colorGlassHighlight"
                android:type="linear" />
        </shape>
    </item>

    <!-- Hairline border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_corner_pill" />
            <stroke
                android:width="@dimen/glass_border"
                android:color="?colorGlassBorder" />
        </shape>
    </item>

</layer-list>
