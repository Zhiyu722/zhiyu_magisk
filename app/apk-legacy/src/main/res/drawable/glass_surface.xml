<?xml version="1.0" encoding="utf-8"?>
<!--
    Reusable translucent "glass" surface, configurable from the theme.

    Usable as android:background on any container (panels, list rows, cards, custom
    dialogs) so the colorful backdrop behind it stays visible:

        android:background="@drawable/glass_surface"

    Layers: frosted fill (?colorGlassSurface) + translucent white highlight fading
    downwards (?colorGlassHighlight) + 1dp hairline border (?colorGlassBorder).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Frosted fill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_corner" />
            <solid android:color="?colorGlassSurface" />
        </shape>
    </item>

    <!-- Translucent white highlight (fades to fully transparent white) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_corner" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="?colorGlassHighlight"
                android:type="linear" />
        </shape>
    </item>

    <!-- Hairline border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/glass_corner" />
            <stroke
                android:width="@dimen/glass_border"
                android:color="?colorGlassBorder" />
        </shape>
    </item>

</layer-list>
