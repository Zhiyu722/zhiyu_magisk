<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:consumeSystemWindowsInsets="start|end"
        app:edgeToEdge="true"
        app:fitsSystemWindowsInsets="start|end"
        tools:ignore="RtlHardcoded">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/main_nav_host"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true"
            app:navGraph="@navigation/main" />

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/main_toolbar_wrapper"
            style="@style/WidgetFoundation.Appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:fitsSystemWindowsInsets="top">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/main_toolbar"
                style="@style/WidgetFoundation.Toolbar"
                android:layout_width="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_scrollFlags="noScroll"
                tools:layout_marginTop="24dp"
                tools:title="Home" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Floating glass navigation pill.

             The system window insets are applied to this transparent wrapper instead of the
             navigation view itself, so the pill keeps its own bottom gap and looks detached
             from the screen edge. The gap is a margin of the wrapper (not of the pill) so the
             wrapper clips the conceal animation exactly at the pill's bottom edge. -->
        <FrameLayout
            android:id="@+id/main_navigation_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/glass_navigation_margin_bottom"
            app:fitsSystemWindowsInsets="start|end|bottom">

            <com.zhiyu.magisk.widget.ConcealableBottomNavigationView
                android:id="@+id/main_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/glass_navigation_margin"
                android:layout_marginEnd="@dimen/glass_navigation_margin"
                android:background="@drawable/glass_navigation_background"
                android:fitsSystemWindows="false"
                android:paddingBottom="0dp"
                app:backgroundTint="@null"
                app:elevation="8dp"
                app:itemActiveIndicatorStyle="@style/WidgetFoundation.Navigation.ActiveIndicator"
                app:itemHorizontalTranslationEnabled="false"
                app:itemIconTint="@color/color_menu_tint"
                app:itemRippleColor="?colorPrimary"
                app:itemTextAppearanceActive="@style/AppearanceFoundation.Tiny.Bold"
                app:itemTextAppearanceInactive="@style/AppearanceFoundation.Tiny.Bold"
                app:itemTextColor="@color/color_menu_tint"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/menu_bottom_nav" />

        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>
